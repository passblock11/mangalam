# Public (browser) — safe in Next.js NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client (moderation / server actions)
SUPABASE_SERVICE_ROLE_KEY=

# Admins sign in with Email+Password (Supabase Auth). Promote a user in SQL:
#   update public.profiles set is_admin = true where id = '<auth.users id>';
