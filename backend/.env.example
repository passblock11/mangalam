SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Local dev server port (see npm run dev)
PORT=3001

# Razorpay (contact-credit recharge; server-only — never put KEY_SECRET in the app)
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_KEY_SECRET=
# Price per contact credit in paise (default 100 = ₹1/credit if unset)
# CONTACT_CREDIT_PRICE_PAISE=100

# MSG91 custom OTP (mobile login — server only)
# MSG91_AUTH_KEY=                 # Required in production (only secret you need by default)
# MSG91_SENDER_ID=SMSIND          # Optional; transactional sendhttp sender
# MSG91_FLOW_TEMPLATE_ID=          # Optional: use POST /v5/flow instead of sendhttp
# MSG91_FLOW_OTP_VAR=VAR1         # Variable name in your Flow template (if using FLOW)
# MSG91_DEV_LOG_OTP=true         # Local: skip SMS, log OTP in server console
# OTP_PEPPER=                     # Secret for hashing OTPs (defaults to SUPABASE_JWT_SECRET)
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=5
# OTP_SEND_COOLDOWN_SEC=60
# OTP_SEND_MAX_PER_HOUR=3
# OTP_SEND_MAX_PER_DAY=10
# OTP_MAX_VERIFY_ATTEMPTS=5
# OTP_MAX_RESENDS_PER_CHALLENGE=1
