SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 JWT secret; ES256 user tokens use JWKS from SUPABASE_URL (no secret needed).
SUPABASE_JWT_SECRET=

# Local dev server port (see npm run dev)
PORT=3001

# Razorpay (contact-credit recharge; server-only — never put KEY_SECRET in the app)
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_KEY_SECRET=
# Price per contact credit in paise (default 100 = ₹1/credit if unset)
# CONTACT_CREDIT_PRICE_PAISE=100

# MSG91 OTP API (mobile login — server only)
# https://docs.msg91.com/otp/llms.txt
# MSG91_AUTH_KEY=                 # Required: authkey header
# MSG91_OTP_TEMPLATE_ID=          # Required: OTP section template with ##OTP## (DLT-mapped in MSG91)
# MSG91_DEV_LOG_OTP=true          # Local: mock SendOTP/Verify without SMS
# OTP_PEPPER=                     # Secret for hashing OTPs (defaults to SUPABASE_JWT_SECRET)
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=5
# OTP_SEND_COOLDOWN_SEC=60
# OTP_SEND_MAX_PER_HOUR=3
# OTP_SEND_MAX_PER_DAY=10
# OTP_MAX_VERIFY_ATTEMPTS=5
# OTP_MAX_RESENDS_PER_CHALLENGE=1
